# ============================================================
# Mascotas Go — Variables de entorno (ejemplo, sin claves reales)
# ============================================================

# --- FreeLLMAPI: gateway de IA propio (SOLO servidor) ---
# Estas variables las lee únicamente el servidor Express. La clave del
# gateway NUNCA debe exponerse al cliente ni llevar prefijo VITE_.

# URL base del gateway FreeLLMAPI (compatible con OpenAI).
# En desarrollo local, FreeLLMAPI corre en la PC del usuario.
FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1

# Clave de API del gateway (la unificada o la de un perfil de cliente).
# Si se deja vacía, el proveedor FreeLLMAPI queda desactivado y la app
# sigue usando Gemini como hasta ahora.
FREELLMAPI_API_KEY=

# Modelo de visión a pedir al gateway (debe aceptar imágenes).
FREELLMAPI_MODEL=google/gemma-4-31b-it
